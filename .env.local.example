NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Envío de presupuestos por correo (Resend). RESEND_API_KEY es un
# secreto de plataforma (una sola cuenta de Resend). El remitente NO va
# acá: cada cuenta carga el suyo en /cuenta (columna accounts.sender_email)
# porque esto es multi-cuenta — no tiene sentido un remitente global.
# RESEND_FROM_EMAIL queda como fallback opcional solo para desarrollo,
# por si querés probar el envío sin pasar por la pantalla de Cuenta.
# El remitente (el que configures acá o en /cuenta) necesita un dominio
# verificado en Resend para mandar a destinatarios reales — en sandbox,
# sin dominio verificado, Resend solo entrega a la casilla del dueño de
# la cuenta de Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
