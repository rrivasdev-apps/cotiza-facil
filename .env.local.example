NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Envío de presupuestos por correo (Resend). Sin estas dos, el botón
# "Enviar por correo" queda deshabilitado pero el resto de la app
# funciona igual. RESEND_FROM_EMAIL necesita un dominio verificado en
# Resend para poder mandar a destinatarios reales (en sandbox, sin
# dominio verificado, Resend solo entrega a la casilla del propio
# dueño de la cuenta).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
