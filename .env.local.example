NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Envío de presupuestos por correo (Resend). RESEND_API_KEY es un
# secreto de plataforma (una sola cuenta de Resend). El remitente NO va
# acá: cada cuenta carga el suyo en /cuenta (columna accounts.sender_email)
# porque esto es multi-cuenta — no tiene sentido un remitente global.
# RESEND_FROM_EMAIL queda como fallback opcional solo para desarrollo,
# por si querés probar el envío sin pasar por la pantalla de Cuenta.
# El remitente (el que configures acá o en /cuenta) necesita un dominio
# verificado en Resend para mandar a destinatarios reales — en sandbox,
# sin dominio verificado, Resend solo entrega a la casilla del dueño de
# la cuenta de Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Token secreto que va en la URL del webhook de Guaybo (?token=...).
# Genera uno con: openssl rand -hex 24
GUAYBO_WEBHOOK_TOKEN=

# URL pública de la app, sin barra final (local: http://localhost:3000;
# producción: el subdominio real, NO la dirección *.vercel.app). Va en todos
# los links que salen hacia afuera: correos, WhatsApp, verificación, CRM.
# Si falta, la app falla con un error claro en vez de generar links rotos.
APP_URL=

# Dominio del remitente por defecto de las cuentas nuevas
# (presupuestos@<dominio>). Debe estar verificado en Resend. Si no se define
# se usa mail.simpletechtraining.com.
EMAIL_SENDER_DOMAIN=

# Clave que cifra los secretos de integración (CRM): exactamente 32 bytes en base64;
# genera una con: openssl rand -base64 32
# Cambiarla invalida los secretos ya guardados.
INTEGRATIONS_ENC_KEY=

# Secreto con el que se llama a /api/crm/retry (header Authorization: Bearer ...).
# Genera uno con: openssl rand -hex 24
CRON_SECRET=
