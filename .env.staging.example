# Conexión a la base de STAGING (nunca la de producción). Supabase → proyecto
# de staging → Connect → cadena de conexión (pooler "Session"); lleva la
# contraseña de la base, así que este archivo no se sube al repo.
# scripts/db-push.mjs se niega a seguir si esta URL contiene el id de producción.
STAGING_DB_URL=
STAGING_PUBLISHABLE_KEY=
STAGING_SECRET_KEY=
STAGING_JWKS_URL=